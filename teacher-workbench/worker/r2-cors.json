{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://fff.xmoj-script.uk",
          "https://localhost",
          "http://localhost",
          "http://127.0.0.1"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 86400
    }
  ]
}
